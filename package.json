{
  "name": "null_ong2-design-system",
  "version": "0.3.1",
  "description": "Production-ready React design system library",
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "typescript"
  ],
  "author": "null_ong2",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.css",
    "dist/index.d.ts",
    "dist/index.d.mts",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/inject-use-client.mjs && node scripts/verify-package.mjs",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build",
    "size": "npm run build && size-limit",
    "size:why": "npm run build && size-limit --why",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "size-limit": "^11.2.0",
    "storybook": "^8.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19"
  },
  "size-limit": [
    {
      "name": "JS — 전체 import",
      "path": "dist/index.mjs",
      "limit": "32 kB"
    },
    {
      "name": "CSS — 전체",
      "path": "dist/index.css",
      "limit": "5.5 kB"
    },
    {
      "name": "JS — Button만 (트리셰이킹)",
      "path": "dist/index.mjs",
      "import": "{ Button }",
      "limit": "3 kB"
    },
    {
      "name": "JS — Modal만 (floating-ui 미포함)",
      "path": "dist/index.mjs",
      "import": "{ Modal }",
      "limit": "6 kB"
    },
    {
      "name": "JS — 폼 세트",
      "path": "dist/index.mjs",
      "import": "{ Input, Select, Checkbox, Button }",
      "limit": "8 kB"
    }
  ]
}
